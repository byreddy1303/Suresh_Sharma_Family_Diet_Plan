# Copy these values into the backend host's environment settings.
# Do not commit real API keys.
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
ALLOWED_ORIGIN=https://byreddy1303.github.io

# Neon Postgres connection string for the family health profile store.
# Provision via Vercel Marketplace > Neon and copy the pooled connection URL.
DATABASE_URL=

# Shared passcode that unlocks the Health Center in the assistant panel.
# Choose a value the family will remember; rotate if it ever leaks.
FAMILY_ADMIN_PASSCODE=
